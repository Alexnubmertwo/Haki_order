{
  "name": "haki-pos",
  "version": "1.0.0",
  "description": "Haki POS для Windows",
  "main": "main.js",
  "author": "Haki",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uz.haki.pos",
    "productName": "Haki POS",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "default-url.txt", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Haki-POS-Setup.exe"
    },
    "portable": {
      "artifactName": "Haki-POS-Portable.exe"
    }
  }
}
